<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Result/DomainError/IClock only. No EF Core, no other module: this is a pure integration
         project (LayeringTests.NonModuleAssemblies_DoNotReferenceEntityFrameworkCore covers it). -->
    <ProjectReference Include="..\Siri.SharedKernel\Siri.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Siri.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain HttpClient against Google's documented OAuth2 + Calendar v3 REST endpoints. Deliberately
         NO Google.Apis.* SDK package (P11-03 contract section 1): IHttpClientFactory is all that is needed. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- GoogleOAuthOptions binding + IValidateOptions. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
