<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Siri.SharedKernel\Siri.SharedKernel.csproj" />
    <ProjectReference Include="..\Siri.Persistence\Siri.Persistence.csproj" />
    <ProjectReference Include="..\Siri.Integrations.Email\Siri.Integrations.Email.csproj" />
    <!-- Notification pipeline on Kafka: IMessageProducer / consumer hosting / topic provisioning. The module depends on the
         project's own abstractions, not on Confluent.Kafka types. -->
    <ProjectReference Include="..\Siri.Integrations.Messaging\Siri.Integrations.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Siri.UnitTests" />
    <InternalsVisibleTo Include="Siri.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for IEndpointRouteBuilder/IServiceCollection endpoint-mapping extension points in
         {Module}Module.cs. Modules stay class libraries (not Sdk.Web) — this only pulls in the
         ASP.NET Core types, not a web host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provider-agnostic EF Core only (no .Npgsql here) — same reasoning as
         Siri.Modules.Identity.csproj: Infrastructure/ owns this module's IEntityTypeConfiguration<T>
         classes, but only Siri.Persistence decides the actual provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Infrastructure/EmailOutboxSenderJob.cs uses Hangfire's [DisableConcurrentExecution] job
         filter attribute directly. -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="FluentValidation" />
    <!-- Delivery guard / send throttle / unread-count cache use the app-wide IConnectionMultiplexer that
         Siri.Persistence registers (AddSharedRedis); same package Catalog and Identity already reference. -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
