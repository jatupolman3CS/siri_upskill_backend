<Project Sdk="Microsoft.NET.Sdk.Worker">

  <ItemGroup>
    <ProjectReference Include="..\Siri.Persistence\Siri.Persistence.csproj" />
    <ProjectReference Include="..\Siri.SharedKernel\Siri.SharedKernel.csproj" />
    <ProjectReference Include="..\Siri.Integrations.Email\Siri.Integrations.Email.csproj" />
    <ProjectReference Include="..\Siri.Integrations.Payment\Siri.Integrations.Payment.csproj" />
    <ProjectReference Include="..\Siri.Integrations.Storage\Siri.Integrations.Storage.csproj" />
    <ProjectReference Include="..\Siri.Integrations.Video\Siri.Integrations.Video.csproj" />
    <ProjectReference Include="..\Siri.Modules.Notification\Siri.Modules.Notification.csproj" />
    <ProjectReference Include="..\Siri.Modules.Analytics\Siri.Modules.Analytics.csproj" />
    <ProjectReference Include="..\Siri.Modules.Commerce\Siri.Modules.Commerce.csproj" />
    <ProjectReference Include="..\Siri.Modules.Media\Siri.Modules.Media.csproj" />
    <ProjectReference Include="..\Siri.Modules.Payout\Siri.Modules.Payout.csproj" />
    <ProjectReference Include="..\Siri.Modules.Identity\Siri.Modules.Identity.csproj" />
    <ProjectReference Include="..\Siri.Modules.Learning\Siri.Modules.Learning.csproj" />
    <ProjectReference Include="..\Siri.Modules.Catalog\Siri.Modules.Catalog.csproj" />
    <ProjectReference Include="..\Siri.Modules.Cms\Siri.Modules.Cms.csproj" />
    <ProjectReference Include="..\Siri.Modules.Community\Siri.Modules.Community.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prevent duplicate publish output files when this worker is referenced by the API project.
         The API already publishes its own appsettings.* files; the worker is a dependency for the
         Hangfire filter and jobs, not a runtime host container payload. -->
    <Content Remove="appsettings*.json" />
    <None Include="appsettings*.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <UserSecretsId>96c7dfcb-d5cd-49cf-ae3b-6b2bbac243cc</UserSecretsId>
  </PropertyGroup>

</Project>
