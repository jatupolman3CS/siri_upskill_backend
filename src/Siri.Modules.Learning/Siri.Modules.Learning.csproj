<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Siri.SharedKernel\Siri.SharedKernel.csproj" />
    <ProjectReference Include="..\Siri.Persistence\Siri.Persistence.csproj" />
    <ProjectReference Include="..\Siri.Modules.Catalog\Siri.Modules.Catalog.csproj" />
    <ProjectReference Include="..\Siri.Modules.Identity\Siri.Modules.Identity.csproj" />
    <!-- X-31: implements Notification.Contracts.IAnnouncementRecipientResolver so Notification can
         deliver course announcements without referencing Learning/Identity directly (Notification cannot
         reference either without creating a circular project reference — see
         docs/contracts/X-31-announcement-delivery.md §3.1). Safe here because Siri.Modules.Notification.csproj
         has no ProjectReference of its own back to any module — it is a dependency "sink". -->
    <ProjectReference Include="..\Siri.Modules.Notification\Siri.Modules.Notification.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets unit tests assert on the real data CertificateService prints (BuildPdfDataAsync) without
         parsing compressed PDF bytes. -->
    <InternalsVisibleTo Include="Siri.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for IEndpointRouteBuilder/IServiceCollection endpoint-mapping extension points in
         {Module}Module.cs. Modules stay class libraries (not Sdk.Web) — this only pulls in the
         ASP.NET Core types, not a web host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provider-agnostic EF Core only (no .Npgsql here) — same reasoning as
         Siri.Modules.Catalog.csproj: this module's Infrastructure/ owns its own
         IEntityTypeConfiguration<T> classes, but only Siri.Persistence decides the actual provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quiz/Assignment cluster (docs/DECISIONS.md D-17 — Repository+Service pattern): request/command
         validation, same role FluentValidation already plays in Catalog/Identity. -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
