<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Siri.SharedKernel\Siri.SharedKernel.csproj" />
    <ProjectReference Include="..\Siri.Persistence\Siri.Persistence.csproj" />
    <ProjectReference Include="..\Siri.Integrations.Email\Siri.Integrations.Email.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for IEndpointRouteBuilder/IServiceCollection endpoint-mapping extension points in
         {Module}Module.cs. Modules stay class libraries (not Sdk.Web) — this only pulls in the
         ASP.NET Core types, not a web host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provider-agnostic EF Core only (no .SqlServer here) — same reasoning as
         Siri.Modules.Identity.csproj: Infrastructure/ owns this module's IEntityTypeConfiguration<T>
         classes, but only Siri.Persistence decides the actual provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Infrastructure/EmailOutboxSenderJob.cs uses Hangfire's [DisableConcurrentExecution] job
         filter attribute directly. -->
    <PackageReference Include="Hangfire.Core" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
