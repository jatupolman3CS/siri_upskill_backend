{
	email {$ACME_EMAIL:admin@siriupskill.com}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$SITE_ADDRESS:siriupskill.siristudiophoto.com} {
	import security_headers
	encode zstd gzip
	@api path /api /api/* /health /sitemap.xml /robots.txt
	handle @api {
		reverse_proxy api:5000
	}
	handle {
		reverse_proxy angular-ssr:4000
	}
}

# Retains a dedicated API hostname for provider webhooks and existing integrations.
{$API_ADDRESS:api-siriupskill.siristudiophoto.com} {
	import security_headers
	encode zstd gzip
	reverse_proxy api:5000
}
