# Template only. Copy to .env.development or .env.production and supply your own values.
# Never copy real credentials into this example. Use __ for nested .NET settings.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5190

# Local .NET processes use these; production Compose supplies its internal hostnames.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=SIRIUPSKILL;Username=siriupskill_app;Password=CHANGE_ME
Redis__ConnectionString=localhost:6379,password=CHANGE_ME,abortConnect=false

# Docker Compose bootstrap: use distinct randomly generated passwords (e.g. base64).
POSTGRES_PASSWORD=CHANGE_ME
SIRI_DATABASE_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

SITE_ADDRESS=siriupskill.siristudiophoto.com
API_ADDRESS=api-siriupskill.siristudiophoto.com
ACME_EMAIL=admin@siriupskill.com
Cors__AllowedOrigins__0=http://localhost:4200
Seo__PublicBaseUrl=http://localhost:4200
Identity__EmailConfirmation__ConfirmEmailUrl=http://localhost:4200/confirm-email
Identity__PasswordReset__ResetPasswordUrl=http://localhost:4200/reset-password

Identity__Jwt__SigningKey=CHANGE_ME_TO_A_RANDOM_SIGNING_KEY_AT_LEAST_32_CHARACTERS
DataProtection__EncryptionKeyBase64=CHANGE_ME_TO_BASE64_OF_32_RANDOM_BYTES
Identity__Seed__AdminEmail=admin@example.test
Identity__Seed__AdminPassword=CHANGE_ME
Identity__Seed__TestUserPassword=CHANGE_ME

# Log is usable locally. Real email confirmation delivery requires Smtp + the workers process.
Email__Provider=Log
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=no-reply@example.test
Email__Smtp__FromDisplayName=SIRI UpSkill
Email__Smtp__UseStartTls=true

# Use Stripe test credentials in Development, live credentials in Production.
Payment__Stripe__SecretKey=CHANGE_ME
Payment__Stripe__PublishableKey=CHANGE_ME
Payment__Stripe__WebhookSecret=CHANGE_ME

# Secure video requires your Bunny library, CDN hostname and token authentication key.
VideoProvider__LibraryId=000000
VideoProvider__ApiKey=CHANGE_ME
VideoProvider__ReadOnlyApiKey=CHANGE_ME
VideoProvider__PullZone=CHANGE_ME
VideoProvider__CdnHostname=
VideoProvider__TokenAuthenticationKey=

# Required by the existing ProductionConfigurationGuard.
Payout__PayerCompanyName=CHANGE_ME
Payout__PayerTaxId=CHANGE_ME
Payout__PayerAddress=CHANGE_ME