<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>


  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Siri.Persistence\Siri.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Siri.SharedKernel\Siri.SharedKernel.csproj" />
    <!-- P0-15: RegisterAndConfirmEmailTests exercises the real Register/ConfirmEmail handlers (and
         the Notification module's outbox they queue into) against the Testcontainers MSSQL instance
         — database.md forbids the EF Core InMemory provider in tests, so this is the only way to
         prove the anti-enumeration/duplicate-registration property with a real database. -->
    <ProjectReference Include="..\..\src\Siri.Modules.Identity\Siri.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\src\Siri.Modules.Notification\Siri.Modules.Notification.csproj" />
    <!-- P1-01: CategoryManagementTests wires AddCatalogModule into its own self-contained
         WebApplication (same DeviceManagementTests/AuthorizationPolicyHttpTests pattern). Already
         reachable transitively through Siri.Api below, but explicit for the same reason every other
         reference in this file is: don't rely on an incidental transitive path. -->
    <ProjectReference Include="..\..\src\Siri.Modules.Catalog\Siri.Modules.Catalog.csproj" />
    <ProjectReference Include="..\..\src\Siri.Modules.Live\Siri.Modules.Live.csproj" />
    <!-- P0-22: AuthorizationPolicyHttpTests exercises Siri.Api.Authorization.AuthorizationPolicyExtensions
         (AdminOnly/InstructorOnly) over real HTTP — same host-project-reference pattern Program.cs's
         trailing `public partial class Program;` comment anticipates for WebApplicationFactory-style
         testing, though this file builds its own minimal WebApplication rather than using Program.cs
         directly (see its own doc comment for why). -->
    <ProjectReference Include="..\..\src\Siri.Api\Siri.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- P0-20: SiriApiFactory boots the real Siri.Api host (Program.cs) via WebApplicationFactory.
         See SiriApiFactory's own doc comment for how its configuration overrides are guaranteed to
         land before Program.cs's top-level configuration reads — the exact timing concern that made
         AuthorizationPolicyHttpTests build its own minimal WebApplication instead. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>